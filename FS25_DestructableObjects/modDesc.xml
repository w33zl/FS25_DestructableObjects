<?xml version="1.0" standalone="no"?>
<modDesc descVersion="94" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/NMC-TBone/xml-schema/main/modDesc.xsd">
    <author>w33zl</author>
    <version>0.5.0.0-dev</version>
    <title>
        <en>[DEV] Destructable Objects</en>
    </title>
    <description>
<en><![CDATA[
Placeable destructible objects to be placed anywhere on your map, can be broken into pieces at your will. They work just as the default crushable rocks on the base game maps.

Crushable Rocks (large)
Output: ROCKS
Capacity: 5200L
Price: $1

Crushable Rocks (extra large)
Output: ROCKS
Capacity: 9000L
Price: $1

Use any jackhammer capable of crushing rocks on the base game maps to destroy these objects.
]]></en>
    </description>
    <l10n>
        <text name="crushableRockXL">
            <en>Extra Large Crushable Rock</en>
            <de>Extra großer brechbarer Felsen</de>
            <fr>Très grande roche broyable</fr>
        </text>
        <text name="crushableRockL">
            <en>Large Crushable Rock</en>
            <de>Großer brechbarer Fels</de>
            <fr>Grande roche broyable</fr>
        </text>
        <text name="crushableRockM">
            <en>Medium Crushable Rock</en>
            <de>Mittelgroßer brechbarer Fels</de>
            <fr>Moyenne roche broyable</fr>
        </text>
        <text name="crushableRockS">
            <en>Small Crushable Rock</en>
            <de>Kleiner brechbarer Felsen</de>
            <fr>Petite roche broyable</fr>
        </text>
        <text name="function_destroyableObject">
            <en>These objects can be crushed with a jackhammer.</en>
            <de>Diese Gegenstände können mit einem Presslufthammer zerkleinert werden.</de>
        </text>
    </l10n>

    <iconFilename>icon_DestructableObjects.dds</iconFilename>
    <multiplayer supported="true" />
    <extraSourceFiles>
